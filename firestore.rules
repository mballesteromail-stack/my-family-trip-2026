rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo los emails de la familia (los mismos que en src/lib/allowedEmails.ts)
    // pueden leer y escribir el estado del checklist.
    function isFamily() {
      return request.auth != null &&
        request.auth.token.email in [
          'mballestero.mail@gmail.com',
          'soledadcalvo.13@gmail.com',
          'mirandaballestero21@gmail.com'
        ];
    }

    match /checklist/{itemId} {
      allow read, write: if isFamily();
    }

    match /content/{itemId} {
      allow read, write: if isFamily();
    }

    match /expenses/{dayId} {
      allow read, write: if isFamily();
    }
  }
}
