rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Toda la familia (los mismos emails que en src/lib/allowedEmails.ts)
    // puede leer. Solo los administradores pueden escribir.
    function isFamily() {
      return request.auth != null &&
        request.auth.token.email in [
          'mballestero.mail@gmail.com',
          'soledadcalvo.13@gmail.com',
          'mirandaballestero21@gmail.com'
        ];
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'mballestero.mail@gmail.com',
          'soledadcalvo.13@gmail.com'
        ];
    }

    match /checklist/{itemId} {
      allow read: if isFamily();
      allow write: if isAdmin();
    }

    match /content/{itemId} {
      allow read: if isFamily();
      allow write: if isAdmin();
    }

    match /expenses/{dayId} {
      allow read: if isFamily();
      allow write: if isAdmin();
    }
  }
}
